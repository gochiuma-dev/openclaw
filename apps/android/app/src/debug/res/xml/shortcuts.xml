<!--
  targetPackage は**実値でなければならない**。`@string/application_id` のままだと
  Firebase App Distribution の検証が
  「Element 'intent' with attribute 'targetPackage' must provide a value,
   not a reference」で APK を弾く（2026-09-09 に実際に踏んだ）。

  manifestPlaceholders は AndroidManifest にしか展開されないので使えない。
  source set で分けて、これは debug 用。src/main/res/xml/shortcuts.xml を上書きする。
  **applicationId を変えたら両方直すこと。**
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.ASK_OPENCLAW"
        app:queryPatterns="@array/ask_openclaw_query_patterns">
        <intent
            android:action="ai.openclaw.app.action.ASK_OPENCLAW"
            android:targetPackage="ai.openclaw.app.debug"
            android:targetClass="ai.openclaw.app.MainActivity">
            <parameter
                android:name="prompt"
                android:key="prompt"
                android:mimeType="https://schema.org/Text"
                android:required="true" />
        </intent>
    </capability>
</shortcuts>
